die("Usage: $0 <WPC-ROM-file> <WPC-code-listing>\n")
	unless (@ARGV == 2);
my($ROM) = shift;

LINE: while (<>) {
	my(@t) = split;
	my($pg,$addr) = ($t[0] =~ m{^<(..):(....)>});
	die($t[0]) unless defined($pg);
	for (my($i)=1; $i<@t; $i++) {
		if ($t[$i] =~ m{^DMDframe#(\d+):}) {
			printf("apexdmd $ROM B%s_A%s %03d.pbm\n",$pg,$addr,$1);
			next LINE;
        }
    }
}

exit(0);
